# memora 服务端配置样例。复制成 /etc/memora/memora.env 后填真值，权限 600。
# 键名与 internal/config/config.go 的 envKeys 一一对应。

# 监听地址。公网机器上写 0.0.0.0:端口，安全组只放行这一个端口（ADR-0009）。
MEMORA_LISTEN_ADDR=0.0.0.0:8443

# SQLite 单文件路径（ADR-0007）。目录要存在且属主是运行用户。
MEMORA_DB_PATH=/var/lib/memora/memora.db

# 证书与私钥，由 deploy/mkcert.sh 生成。
MEMORA_TLS_CERT=/etc/memora/tls/server.crt
MEMORA_TLS_KEY=/etc/memora/tls/server.key

# 访问口令的 bcrypt 哈希。生成：printf '%s' '口令' | memora hashpass
# 口令本身不写在这里，也不进任何文档（writing-rules §9）。
MEMORA_PASS_HASH=$2y$10$替换成你自己的哈希

# 归属周期按这个时区的日历算（需求 §4）。偏移写法不依赖宿主机 tzdata。
MEMORA_LOCAL_TZ=+08:00

# 一条记录的最大字符数，超了直接 413 拒绝，不静默截断。留空默认 2000。
MEMORA_MAX_NOTE_CHARS=2000

# 安卓更新包目录（ADR-0015）：里面放 release.json 与 app.apk，服务端只读不写。
# 发版用 scripts/release.sh 拷进来。systemd 的 ProtectSystem=strict 下只有
# /var/lib/memora 可写，别指到 /etc 或 /opt 去。留空则 /v1/app/release 一律 404，
# 其余接口不受影响。
MEMORA_RELEASE_DIR=/var/lib/memora/release

# 外部模型（ADR-0003）。API_KEY 由需求方自己填，不要贴进对话或提交。
# key 只写 ASCII：Authorization 头按 latin-1 解码，中文 key 到服务端会变形成另一种字节。
MEMORA_LLM_BASE_URL=https://api.deepseek.com/v1
MEMORA_LLM_MODEL=deepseek-chat
MEMORA_LLM_API_KEY=

# 定时生成时刻，口径未定（见 NOW 待确认），先留着不生效。
MEMORA_WEEKLY_AT=
MEMORA_MONTHLY_AT=

# 置 true 时日志降到 Debug。
MEMORA_LOG_DEBUG=
